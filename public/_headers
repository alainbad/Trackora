/*
  # Force HTTPS — enforced for 1 year
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent MIME-sniffing
  X-Content-Type-Options: nosniff

  # Deny framing from other origins (clickjacking protection)
  X-Frame-Options: SAMEORIGIN

  # Restrict referrer info sent to third parties
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable browser features not needed by this app
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://www.google.com https://logo.clearbit.com https://icons.duckduckgo.com https://favicone.com https://*.supabase.co https://assets.aftership.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://badranalain.gumroad.com https://pagead2.googlesyndication.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; frame-ancestors 'none'

  # Remove server fingerprint
  X-Powered-By:

# Cache immutable JS/CSS bundles for 1 year (Vite adds content hash to filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache static images for 1 week
/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

# Cache SEO files for 1 day
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400
